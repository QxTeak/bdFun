          },
          {
            "pref_name": "color_style",
            "type": "select",
            "title": "色彩风格",
            "default": 0,
            "options": [
              {
                "title": "AC 粉",
                "value": 0
              },
              {
                "title": "Hyper 蓝",
                "value": 1
              }
            ]
          },
          {
            "pref_name": "interface_style",
            "type": "select",
            "title": "界面风格",
            "default": 0,
            "options": [
              {
                "title": "官方",
                "value": 0
              },
              {
                "title": "经典",
                "value": 1
              },
              {
                "title": "HyperOS 4",
                "value": 2
              }
            ]
          }
        ]
      },
      {
        "title": "界面与动效",
