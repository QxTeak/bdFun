[
  {
    "name": "外观与显示",
    "route": "settings/appearance",
    "groups": [
      {
        "title": "主题与风格",
        "settings": [
          {
            "pref_name": "dark_mode",
            "type": "dropdown",
            "title": "主题",
            "default": 0,
            "options": [
              {
                "title": "跟随系统",
                "value": 0
              },
              {
                "title": "浅色",
                "value": 1
              },
              {
                "title": "深色",
                "value": 2
              }
            ]
          },
          {
            "pref_name": "color_style",
            "type": "dropdown",
            "title": "色彩风格",
            "default": 0,
            "options": [
              {
                "title": "AC 粉",
                "value": 0
              },
              {
                "title": "Hyper 蓝",
                "value": 1
              }
            ]
          },
          {
            "pref_name": "interface_style",
            "type": "dropdown",
            "title": "界面风格",
            "default": 2,
            "options": [
              {
                "title": "HyperOS 4",
                "value": 2
              },
              {
                "title": "哔哩哔哩",
                "value": 0
              },
              {
                "title": "经典",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "title": "界面效果",
        "settings": [
          {
            "pref_name": "blur",
            "type": "switch",
            "title": "高级材质",
            "default": true
          },
          {
            "pref_name": "animations_enabled",
            "type": "switch",
            "title": "减弱动态效果",
            "default": true,
            "inverted": true
          },
          {
            "pref_name": "predictive_back",
            "type": "switch",
            "title": "预测性返回",
            "default": false
          },
          {
            "pref_name": "feed_refresh_rate",
            "type": "dropdown",
            "title": "信息流帧率",
            "default": 60,
            "subtitle": "主界面刷新率；自适应由系统决定",
            "options": [
              {
                "title": "60",
                "value": 60
              },
              {
                "title": "120",
                "value": 120
              },
              {
                "title": "自适应",
                "value": 0
              }
            ]
          },
          {
            "pref_name": "smart_refresh",
            "type": "switch",
            "title": "智能刷新率",
            "default": true,
            "subtitle": "根据画面状态自动调整屏幕刷新率"
          },
          {
            "pref_name": "tab_click_refresh",
            "type": "switch",
            "title": "点击底栏回顶并刷新",
            "default": true
          },
          {
            "pref_name": "bottom_bar_raise",
            "type": "switch",
            "title": "抬高底栏",
            "default": false,
            "subtitle": "解决未开启安卓导航条时底栏位置过低的问题"
          },
          {
            "pref_name": "font_scale",
            "type": "font_scale",
            "title": "全局字号",
            "default": 1,
            "value_type": "decimal"
          },
          {
            "pref_name": "vibration",
            "type": "switch",
            "title": "震动",
            "default": true
          }
        ]
      },
      {
        "title": "回到顶部",
        "settings": [
          {
            "pref_name": "scroll_top_enabled",
            "type": "switch",
            "title": "回到顶部控件",
            "default": true
          },
          {
            "pref_name": "scroll_top_side",
            "type": "dropdown",
            "title": "回到顶部控件位置",
            "default": 1,
            "options": [
              {
                "title": "左侧",
                "value": 0
              },
              {
                "title": "右侧",
                "value": 1
              }
            ],
            "visible_when": "scroll_top_enabled"
          },
          {
            "pref_name": "scroll_top_pages",
            "type": "page_switches",
            "title": "回到顶部控件显示页面",
            "storage": "settings",
            "default": [
              "home",
              "dynamic",
              "live",
              "pgc",
              "comment",
              "space",
              "library",
              "message",
              "message_detail"
            ],
            "visible_when": "scroll_top_enabled"
          }
        ]
      },
      {
        "title": "个性化",
        "settings": [
          {
            "pref_name": "wallpaper_pick",
            "type": "action",
            "title": "设置开屏壁纸",
            "storage": "none",
            "default": ""
          },
          {
            "pref_name": "wallpaper_clear",
            "type": "action",
            "title": "清除开屏壁纸",
            "storage": "none",
            "default": ""
          }
        ]
      }
    ]
  },
  {
    "name": "播放器",
    "route": "settings/player",
    "groups": [
      {
        "title": "界面与手势",
        "settings": [
          {
            "pref_name": "show_viewer_count",
            "type": "switch",
            "title": "显示正在观看人数",
            "default": true
          },
          {
            "pref_name": "show_fullscreen_actions",
            "type": "switch",
            "title": "全屏显示互动按钮",
            "default": true
          },
          {
            "pref_name": "show_fullscreen_time",
            "type": "switch",
            "title": "全屏显示时间",
            "default": true
          },
          {
            "pref_name": "gesture_brightness_volume",
            "type": "switch",
            "title": "亮度/音量划动手势",
            "default": true
          },
          {
            "pref_name": "gesture_center_fullscreen",
            "type": "switch",
            "title": "视频中部上下划屏切换/退出全屏模式",
            "default": true
          },
          {
            "pref_name": "gesture_boost_swipe",
            "type": "switch",
            "title": "长按倍速划动调速",
            "default": true
          },
          {
            "pref_name": "boost_default_speed",
            "type": "dropdown",
            "title": "长按默认倍率",
            "default": 3,
            "options": [
              {
                "title": "1.5×",
                "value": 1.5
              },
              {
                "title": "2×",
                "value": 2
              },
              {
                "title": "2.5×",
                "value": 2.5
              },
              {
                "title": "3×",
                "value": 3
              },
              {
                "title": "4×",
                "value": 4
              },
              {
                "title": "5×",
                "value": 5
              }
            ],
            "value_type": "decimal"
          },
          {
            "pref_name": "default_playback_speed",
            "type": "dropdown",
            "title": "默认播放倍率",
            "default": 1,
            "options": [
              {
                "title": "0.5×",
                "value": 0.5
              },
              {
                "title": "0.75×",
                "value": 0.75
              },
              {
                "title": "1×",
                "value": 1
              },
              {
                "title": "1.25×",
                "value": 1.25
              },
              {
                "title": "1.5×",
                "value": 1.5
              },
              {
                "title": "2×",
                "value": 2
              },
              {
                "title": "2.5×",
                "value": 2.5
              },
              {
                "title": "3×",
                "value": 3
              }
            ],
            "value_type": "decimal"
          },
          {
            "pref_name": "progress_bar_mode",
            "type": "dropdown",
            "title": "进度条常显",
            "default": 0,
            "options": [
              {
                "title": "关闭",
                "value": 0
              },
              {
                "title": "仅半屏时常显",
                "value": 1
              },
              {
                "title": "仅全屏时常显",
                "value": 2
              },
              {
                "title": "永久显示",
                "value": 3
              }
            ]
          },
          {
            "pref_name": "auto_rotate",
            "type": "switch",
            "title": "自动旋转",
            "default": true
          }
        ]
      },
      {
        "title": "播放与解码",
        "settings": [
          {
            "pref_name": "auto_play",
            "type": "switch",
            "title": "进入视频自动播放",
            "default": true
          },
          {
            "pref_name": "quality",
            "type": "dropdown",
            "title": "默认清晰度",
            "default": 0,
            "options": [
              {
                "title": "自动",
                "value": 0
              },
              {
                "title": "HDR",
                "value": 125
              },
              {
                "title": "4K",
                "value": 120
              },
              {
                "title": "1080P 60FPS",
                "value": 116
              },
              {
                "title": "1080P+",
                "value": 112
              },
              {
                "title": "1080P",
                "value": 80
              },
              {
                "title": "720P",
                "value": 64
              }
            ]
          },
          {
            "pref_name": "resume_playback",
            "type": "switch",
            "title": "播放进度记忆",
            "default": true
          },
          {
            "pref_name": "adaptive_buffering",
            "type": "switch",
            "title": "自适应缓冲",
            "subtitle": "本地学习观看习惯，优化缓冲机制",
            "default": false
          },
          {
            "pref_name": "decoder_mode",
            "type": "dropdown",
            "title": "硬解模式",
            "default": 0,
            "options": [
              {
                "title": "自动",
                "value": 0
              },
              {
                "title": "硬件解码",
                "value": 1
              },
              {
                "title": "软件解码",
                "value": 2
              },
              {
                "title": "硬件解码（禁回退）",
                "value": 3
              }
            ]
          },
          {
            "pref_name": "codec_preference",
            "type": "dropdown",
            "title": "首选解码格式",
            "default": "auto",
            "subtitle": "不可用时自动回退到其他编码",
            "options": [
              {
                "title": "自动",
                "value": "auto"
              },
              {
                "title": "AVC (H.264)",
                "value": "avc"
              },
              {
                "title": "HEVC (H.265)",
                "value": "hevc"
              },
              {
                "title": "AV1",
                "value": "av1"
              },
              {
                "title": "DVH1",
                "value": "dvh1"
              }
            ]
          },
          {
            "pref_name": "cdn_service",
            "type": "cdn_dropdown",
            "title": "CDN 设置",
            "default": "auto",
            "subtitle": "如发现播放问题，请选择原地址"
          }
        ]
      },
      {
        "title": "声音与蓝牙",
        "settings": [
          {
            "pref_name": "loudness_eq",
            "type": "switch",
            "title": "响度均衡",
            "default": false
          },
          {
            "pref_name": "bt_latency_enabled",
            "type": "switch",
            "title": "蓝牙耳机延迟补偿",
            "default": false,
            "subtitle": "检测到蓝牙耳机设备时自动校准播放延迟"
          }
        ]
      },
      {
        "title": "后台播放",
        "settings": [
          {
            "pref_name": "background_play",
            "type": "switch",
            "title": "离开 App 或锁屏后继续播放",
            "default": true
          },
          {
            "pref_name": "show_disc_after_video",
            "type": "switch",
            "title": "退出视频页后继续播放",
            "default": true
          },
          {
            "pref_name": "exit_video_control",
            "type": "dropdown",
            "title": "播放控件",
            "default": 1,
            "options": [
              {
                "title": "画中画",
                "value": 0
              },
              {
                "title": "唱片",
                "value": 1
              }
            ],
            "visible_when": "show_disc_after_video"
          },
          {
            "pref_name": "disc_breath_enabled",
            "type": "switch",
            "title": "唱片呼吸灯",
            "default": false,
            "visible_when": "show_disc_after_video&&exit_video_control=1"
          },
          {
            "pref_name": "disc_breath_cover_color",
            "type": "switch",
            "title": "呼吸灯颜色跟随封面",
            "default": false,
            "visible_when": "show_disc_after_video&&exit_video_control=1&&disc_breath_enabled"
          }
        ]
      }
    ]
  },
  {
    "name": "视频详情与弹幕",
    "route": "settings/video",
    "groups": [
      {
        "title": "视频详情页",
        "settings": [
          {
            "pref_name": "immersive_status",
            "type": "switch",
            "title": "沉浸状态栏",
            "default": false
          },
          {
            "pref_name": "show_ip_location",
            "type": "switch",
            "title": "显示评论 IP 属地",
            "default": true
          }
        ]
      },
      {
        "title": "弹幕",
        "settings": [
          {
            "pref_name": "sponsor_skip_mode",
            "type": "dropdown",
            "title": "空降助手",
            "subtitle": "提示片段，或进入片段后自动跳到结尾",
            "default": 1,
            "options": [
              {
                "title": "关闭",
                "value": 0
              },
              {
                "title": "提示",
                "value": 1
              },
              {
                "title": "自动跳过",
                "value": 2
              }
            ]
          },
          {
            "pref_name": "hot_danmaku",
            "type": "switch",
            "title": "弹幕计数",
            "default": true
          },
          {
            "pref_name": "dm_low_refresh",
            "type": "switch",
            "title": "降低弹幕刷新率",
            "default": true
          },
          {
            "pref_name": "video_interaction",
            "type": "switch",
            "title": "视频互动",
            "subtitle": "弹幕投票、评分与关注卡片等",
            "default": true
          }
        ]
      }
    ]
  },
  {
    "name": "首页、动态与搜索",
    "route": "settings/feeds",
    "groups": [
      {
        "title": "首页推荐",
        "settings": [
          {
            "pref_name": "home_card_style",
            "type": "dropdown",
            "title": "首页卡片样式",
            "default": 0,
            "options": [
              {
                "title": "双排小卡",
                "value": 0
              },
              {
                "title": "大卡",
                "value": 1
              }
            ]
          },
          {
            "pref_name": "recommend_web",
            "type": "switch",
            "title": "首页使用 Web 端推荐",
            "default": false
          },
          {
            "pref_name": "recommendation_toggle",
            "type": "extension",
            "title": "推荐算法优化",
            "subtitle": "本地优化推荐内容，减少重复推送",
            "storage": "none",
            "default": "",
            "visible_when": "extension:recommendation_toggle"
          },
          {
            "pref_name": "recommendation_clear",
            "type": "extension",
            "title": "清除推荐学习记录",
            "storage": "none",
            "default": "",
            "visible_when": "extension:recommendation_clear"
          },
          {
            "pref_name": "recommendation_error",
            "type": "extension",
            "title": "推荐记录",
            "storage": "none",
            "default": "",
            "visible_when": "extension:recommendation_error"
          }
        ]
      },
      {
        "title": "动态页",
        "settings": [
          {
            "pref_name": "dynamic_auto_play",
            "type": "switch",
            "title": "动态视频自动播放",
            "default": true
          },
          {
            "pref_name": "dynamic_auto_play_quality",
            "type": "dropdown",
            "title": "动态视频清晰度",
            "default": 64,
            "options": [
              {
                "title": "1080P",
                "value": 80
              },
              {
                "title": "720P",
                "value": 64
              },
              {
                "title": "480P",
                "value": 32
              }
            ]
          }
        ]
      },
      {
        "title": "搜索页",
        "settings": [
          {
            "pref_name": "show_search_history",
            "type": "switch",
            "title": "显示搜索记录",
            "default": true
          },
          {
            "pref_name": "show_search_discovery",
            "type": "switch",
            "title": "显示搜索发现",
            "default": true
          },
          {
            "pref_name": "show_hot_search",
            "type": "switch",
            "title": "显示热搜",
            "default": true
          }
        ]
      }
    ]
  },
